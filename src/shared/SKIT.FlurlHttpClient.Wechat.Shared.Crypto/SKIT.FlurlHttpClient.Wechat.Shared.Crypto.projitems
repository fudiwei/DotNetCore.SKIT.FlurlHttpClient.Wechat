    <Compile Include="$(MSBuildThisFileDirectory)PemReader.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PemWriter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)X509Loader.cs" />
  </ItemGroup>
</Project>