<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0; net462; net6.0; net8.0; net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SKIT.FlurlHttpClient.Wechat.Work</PackageId>
        <PackageVersion>4.0.1</PackageVersion>
		<PackageIcon>LOGO.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/fudiwei/DotNetCore.SKIT.FlurlHttpClient.Wechat</PackageProjectUrl>
        <PackageTags>Flurl.Http; Wechat; Weixin; MicroMessage; WechatWork; WeixinWork; WxWork; WeWork; WeCom; 微信; 企业微信; 企业号; 微信企业号</PackageTags>
        <Authors>Fu Diwei</Authors>
        <Description>基于 Flurl.Http 的企业微信 API 客户端 SDK。</Description>
    </PropertyGroup>

	<ItemGroup>
		<None Include="../../LOGO.png" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="EventsFixtures/**/*.*" />
        <None Include="ModelsFixtures/**/*.*" />
        <None Include="ExtendedSDK/**/EventsFixtures/**/*.*" />
        <None Include="ExtendedSDK/**/ModelsFixtures/**/*.*" />
    </ItemGroup>

    <ItemGroup>
        <ContentWithTargetPath Include="ExtendedSDK/Finance/__DLL/*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(Filename)%(Extension)</TargetPath>
        </ContentWithTargetPath>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SKIT.FlurlHttpClient.Common" Version="4.0.1" />
        <PackageReference Include="SKIT.JsonConv.NewtonsoftJson" Version="0.1.2" />
        <PackageReference Include="SKIT.JsonConv.SystemTextJson" Version="0.1.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.Bcl.Cryptography" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net' Or '$(TargetFramework.TrimEnd(`0123456789.`))' == 'netstandard'">
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageReference Include="System.Formats.Asn1" Version="10.0.15" />
    </ItemGroup>

    <Import Project="..\shared\SKIT.FlurlHttpClient.Wechat.Shared.Crypto\SKIT.FlurlHttpClient.Wechat.Shared.Crypto.projitems" Label="Shared" />
    <Import Project="..\shared\SKIT.FlurlHttpClient.Wechat.Shared.Crypto.RSA\SKIT.FlurlHttpClient.Wechat.Shared.Crypto.RSA.projitems" Label="Shared" />
    <Import Project="..\shared\SKIT.FlurlHttpClient.Wechat.Shared.Crypto.SM\SKIT.FlurlHttpClient.Wechat.Shared.Crypto.SM.projitems" Label="Shared" />

</Project>
