<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0; net462; net6.0; net8.0; net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SKIT.FlurlHttpClient.Wechat.TenpayV3</PackageId>
        <PackageVersion>4.0.0-dev</PackageVersion>
		<PackageIcon>LOGO.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/fudiwei/DotNetCore.SKIT.FlurlHttpClient.Wechat</PackageProjectUrl>
        <PackageTags>Flurl.Http; Wechat; Weixin; MicroMessage; Tenpay; WechatPay; WeixinPay; Wxpay; 微信; 微信支付; 微信商户; 微信商户平台</PackageTags>
        <Authors>Fu Diwei</Authors>
        <Description>基于 Flurl.Http 的微信商户平台（微信支付）API v3 客户端 SDK。</Description>
    </PropertyGroup>

	<ItemGroup>
		<None Include="../../LOGO.png" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="ModelsFixtures/**/*.json" />
        <None Include="EventsFixtures/**/*.json" />
        <None Include="ExtendedSDK/Global/ModelsFixtures/**/*.json" />
        <None Include="ExtendedSDK/Global/EventsFixtures/**/*.json" />
	</ItemGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
        <PackageReference Include="System.ValueTuple" Version="4.6.2" Condition="'$(TargetFramework)' == 'net462'" />
        <PackageReference Include="SKIT.FlurlHttpClient.Common" Version="4.0.0" />
        <PackageReference Include="SKIT.JsonConv.NewtonsoftJson" Version="0.1.2" />
        <PackageReference Include="SKIT.JsonConv.SystemTextJson" Version="0.1.2" />
    </ItemGroup>

</Project>
