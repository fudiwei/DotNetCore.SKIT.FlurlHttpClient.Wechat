<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0; net462; net6.0; net8.0; net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SKIT.FlurlHttpClient.Wechat.Api</PackageId>
        <PackageVersion>4.0.0-dev</PackageVersion>
		<PackageIcon>LOGO.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/fudiwei/DotNetCore.SKIT.FlurlHttpClient.Wechat</PackageProjectUrl>
        <PackageTags>Flurl.Http; Wechat; Weixin; MicroMessage; MiniProgram; MiniGame; MiniStore; WechatFinder; WechatChannel; 微信; 公众号; 服务号; 订阅号; 小程序; 小游戏; 小商店; 视频号; 公众平台; 开放平台; 微信公众号; 微信服务号; 微信订阅号; 微信小程序; 微信小游戏; 微信小商店; 微信视频号; 微信公众平台; 微信开放平台</PackageTags>
        <Authors>Fu Diwei</Authors>
        <Description>基于 Flurl.Http 的微信公众平台（订阅号、服务号、小程序、小游戏、小商店、视频号）、微信开放平台 API 客户端 SDK。</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../LOGO.png" Pack="true" PackagePath="/" />
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="ModelsFixtures/**/*.json" />
        <None Include="EventsFixtures/**/*.json" />
        <None Include="EventsFixtures/**/*.xml" />
	</ItemGroup>

	<ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
        <PackageReference Include="SKIT.FlurlHttpClient.Common" Version="4.0.0" />
        <PackageReference Include="SKIT.JsonConv.NewtonsoftJson" Version="0.1.2" />
        <PackageReference Include="SKIT.JsonConv.SystemTextJson" Version="0.1.2" />
	</ItemGroup>

</Project>
